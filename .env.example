# Copy to .env and fill in your API keys:
#   cp .env.example .env

# ── which model plans the agent's actions ────────────────────────────────────
# ollama = local & free (no key needed) | groq = free hosted tier
# gemini = free tier (needs GOOGLE_API_KEY) | anthropic = paid Claude
# anthropic (claude-sonnet-5-5) is the baseline for all tests
# PLANNER_PROVIDER=anthropic < commented out because of pinned setup for testing

# optional per-provider model overrides (defaults live in llm.py PLANNER_MODELS)
# OLLAMA_MODEL=qwen2.5:7b
# GROQ_MODEL must support json_schema structured output (gpt-oss-120b/20b, kimi-k2-instruct — NOT llama-3.3)
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.0-flash
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_EFFORT=medium  (low | medium | high; keep fixed across test runs)
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── vision channel ──────────
# must be vision-capable + support structured output (gemini flash, claude,
# ollama qwen2.5vl, groq llama-4). uses the matching provider key above.
# USE_VISION=true
# VISION_PROVIDER=gemini
# VISION_MODEL=gemini-3.5-flash

# ── keys (only the one for your chosen provider is required) ──────────────────
# GROQ_API_KEY: free from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# CLAUDE_API_KEY: paid, from https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=your-anthropic-api-key
# ollama needs NO key; optionally point at a non-default server:
# OLLAMA_HOST=http://localhost:11434

# GOOGLE_API_KEY: powers gemini planner (and voice transcription). free from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key
# GLASSES_VISION_PROVIDER=gemini   (reads POV photos from the glasses; needs GOOGLE_API_KEY)
# GLASSES_VISION_MODEL=gemini-2.0-flash
OPENAI_API_KEY=your-openai-api-key

# ── pinned setup for testing ──────────────────────────────────────────────────
# change only on purpose, and note it in the decisions log
PLANNER_PROVIDER=anthropic
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=medium
USE_VISION=true
VISION_PROVIDER=anthropic
VISION_MODEL=claude-sonnet-5-5
EXTRACTION_PROVIDER=anthropic
EXTRACTION_MODEL=claude-sonnet-5-5
GLASSES_VISION_PROVIDER=anthropic
GLASSES_VISION_MODEL=claude-sonnet-5-5
# price-lookup tuning for the glasses demo (prompt rules + early exits once a $ price is found). tests set PRICE_TUNING=false
PRICE_TUNING=true
# optional: pin the browser binary. unset = browser_use searches /Applications etc.
# BROWSER_PATH=/Users/<you>/Library/Caches/ms-playwright/chromium-1223/chrome-mac-arm64/Google Chrome for Testing.app/Contents/MacOS/Google Chrome for Testing